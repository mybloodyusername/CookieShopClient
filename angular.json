{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "pnpm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "CookieShopClient": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "skipTests": true,
          "addTypeToClassName": true,
          "changeDetection": "OnPush",
          "path": "src/app/components",
          "prefix": "cookie"
        },
        "@schematics/angular:class": {
          "skipTests": true,
          "path": "src/app/classes"
        },
        "@schematics/angular:directive": {
          "skipTests": true,
          "path": "src/app/directives",
          "addTypeToClassName": true
        },
        "@schematics/angular:guard": {
          "skipTests": true,
          "path": "src/app/guards",
          "typeSeparator": ".",
          "functional": true
        },
        "@schematics/angular:interceptor": {
          "skipTests": true,
          "path": "src/app/interceptors",
          "typeSeparator": ".",
          "functional": true
        },
        "@schematics/angular:pipe": {
          "skipTests": true,
          "path": "src/app/pipes",
          "typeSeparator": "."
        },
        "@schematics/angular:resolver": {
          "skipTests": true,
          "path": "src/app/resolvers",
          "typeSeparator": ".",
          "functional": true
        },
        "@schematics/angular:service": {
          "skipTests": true,
          "path": "src/app/services",
          "addTypeToClassName": true
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "src/styles.scss"
            ],
            "server": "src/main.server.ts",
            "outputMode": "server",
            "security": {
              "allowedHosts": []
            },
            "ssr": {
              "entry": "src/server.ts"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "CookieShopClient:build:production"
            },
            "development": {
              "buildTarget": "CookieShopClient:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
