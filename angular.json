{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "pnpm"
  },
  "newProjectRoot": "projects",
  "schematics": {
    "@schematics/angular:application": {
      "zoneless": true,
      "skipTests": true,
      "standalone": true,
      "prefix": "cs",
      "inlineStyle": false,
      "inlineTemplate": false,
      "fileNameStyleGuide": "2025"
    },
    "@schematics/angular:component": {
      "prefix": "cs",
      "changeDetection": "OnPush",
      "standalone": true,
      "skipTests": true,
      "inlineTemplate": false,
      "inlineStyle": false,
      "path": "src/app/components",
      "flat": false
    },
    "@schematics/angular:directive": {
      "standalone": true,
      "prefix": "cs",
      "addTypeToClassName": true,
      "type": "directive",
      "skipTests": true,
      "path": "src/app/directives"
    },
    "@schematics/angular:guard": {
      "skipTests": true,
      "functional": true,
      "typeSeparator": ".",
      "path": "src/app/guards"
    },
    "@schematics/angular:interceptor": {
      "skipTests": true,
      "typeSeparator": ".",
      "functional": true,
      "path": "src/app/interceptors"
    },
    "@schematics/angular:pipe": {
      "skipTests": true,
      "typeSeparator": ".",
      "standalone": true,
      "path": "src/app/pipes"
    },
    "@schematics/angular:resolver": {
      "skipTests": true,
      "functional": true,
      "typeSeparator": ".",
      "path": "src/app/resolvers"
    },
    "@schematics/angular:service": {
      "skipTests": true,
      "type": "service",
      "addTypeToClassName": true,
      "path": "src/app/services"
    }
  },
  "projects": {
    "CookieShopClient": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": ["src/styles.scss"],
            "server": "src/main.server.ts",
            "outputMode": "server",
            "security": {
              "allowedHosts": []
            },
            "ssr": {
              "entry": "src/server.ts"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "CookieShopClient:build:production"
            },
            "development": {
              "buildTarget": "CookieShopClient:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
